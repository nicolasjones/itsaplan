+// BUG-297 (MSF-338): an EPIC must not land on a history-only state (En revision, En curso,
+// Merging, Listo...). This app does not validate column x type: `assertColumn` only checks that
+// the column belongs to the project, so an epic could be parked on a history state and would
+// leave the poller cycle — the poller only asks about epics in 'Implementation In Progress'
+// and the release stages, so nobody would promote it to 'Review In DEV' and it would wait
+// for a human. The mapping (project, issue type, column) lives in `guard_columna_prohibida`,
+// kept in sync by the operator; the Postgres trigger `trg_issue_columna_por_tipo` is the
+// final net. This check gives the legible 400.
+// Fail-safe: if the guard table is missing (a fresh install), nothing is blocked.
+export async function assertColumnForType(
+  projectId: number,
+  typeId: number | null | undefined,
+  columnId: number | undefined,
+): Promise<void> {
+  if (columnId === undefined || typeId == null) return;
+  let motivo: string | undefined;
+  try {
+    const rows = await db.execute(sql`
+      SELECT g.motivo AS motivo FROM guard_columna_prohibida g
+       WHERE g.project_id = ${projectId}
+         AND g.tipo_id = ${typeId}
+         AND g.project_column_id = ${columnId}
+    `);
+    motivo = (rows as { motivo?: string }[])[0]?.motivo ?? undefined;
+  } catch {
+    return; // no guard table (fresh install): never block the flow on it
+  }
+  if (!motivo) return;
+  throw new HttpError(
+    400,
+    `"${motivo}" is a HISTORY state and an epic does not use it: an epic on a history state leaves the ` +
+      `poller cycle — nobody promotes it to "Review In DEV" and it waits for a human. Epic states: ` +
+      `Backlog, Ready For Spec, Spec In Progress, Spec Review, Needs Info, Changes Requested, ` +
+      `Spec Approved, Implementation In Progress, Blocked, Review In DEV, Approved In Dev, Review In STG, ` +
+      `Approved In STG, Finalizada. If its stories are done and the closure is in review, the state is ` +
+      `"Implementation In Progress" (the poller promotes it to "Review In DEV" once the closure story ` +
+      `is Finalizada).`,
+  );
+}
